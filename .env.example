# Copy this file to .env before running docker compose.
# Generate strong values, for example: openssl rand -base64 32
SPRING_PROFILES_ACTIVE=prod
APP_BASE_URL=http://localhost:8080
API_KEY=
API_KEY_PEPPER=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Optional host port overrides (use these if a port is already in use)
# APP_HOST_PORT=8080
# POSTGRES_HOST_PORT=5432
# REDIS_HOST_PORT=6379

# Optional tuning
# CACHE_TTL=PT1H
# RATE_LIMIT_REQUESTS=100
# RATE_LIMIT_WINDOW=PT1M
# REDIRECT_RATE_LIMIT_REQUESTS=600
# REDIRECT_RATE_LIMIT_WINDOW=PT1M
# ANALYTICS_RETENTION=P365D
# EXPIRED_URL_RETENTION=P30D
# CLEANUP_BATCH_SIZE=500
# CLEANUP_CRON="0 0 3 * * *"
